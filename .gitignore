# Variables de entorno (PennylessTrack)
#   .env guarda contraseñas y claves, nunca se sube.
#   .env.* ignora también sus variantes (.env.local, .env.production...).
#   !.env.example permite subir la plantilla sin valores reales.
.env
.env.*
!.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
#   NO NECESARIO: no uso extensiones en C
# *.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#   NO NECESARIO: no voy a generar ejecutables .exe
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
# *.manifest
# *.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

